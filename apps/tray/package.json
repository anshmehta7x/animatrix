{
  "name": "@anshmehta7x/animatrix-tray",
  "version": "0.1.0",
  "private": true,
  "description": "animatrix tray app: compact control panel with live LED preview",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "build": "vite build && node build-electron.mjs",
    "start": "pnpm build && electron .",
    "dev": "node build-electron.mjs && concurrently -k \"vite\" \"ANIMATRIX_DEV_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anshmehta7x/animatrix": "workspace:*",
    "@anshmehta7x/animatrix-core": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "dbus-next": "^0.10.2",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "vite": "^8.3.4"
  }
}
