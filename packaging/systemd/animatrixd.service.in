[Unit]
Description=animatrix daemon (ASUS AniMe Matrix)
Documentation=https://github.com/anshmehta7x/animatrix
# The session bus restarts on GNOME logout; keep retrying for as long as that takes.
StartLimitIntervalSec=0

[Service]
# Not Type=dbus: systemd would treat the bus restart as a clean stop and never start us again
# while the user manager lingers across logout/login.
Type=exec
ExecStart=@BINDIR@/animatrixd
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
